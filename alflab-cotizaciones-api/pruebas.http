### =========================================================
### PREPARACIÓN DE DATOS ANTES DE QUE LLEGUE EL MAESTRO
### =========================================================
# ⚠️ EJECUTA ESTO 3 O 4 VECES CAMBIANDO EL CLIENTE Y EL TOTAL 
# PARA LLENAR TU BASE DE DATOS DE DUMMYS.
POST {{HostAddress}}/api/cotizaciones
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "clienteId": "EMP-996",
  "descripcion": "Cotización de Mantenimiento apagon replica",
  "total": 15,
  "productos": [
    { "nombre": "Mantenimiento Preventivo", "cantidad": 1, "precio": 15000 }
  ]
}

### =========================================================
### PASO 1 Y 4: CONSULTAR REPLICA (HAPPY PATH)
### =========================================================
# Demuestra que la réplica te devuelve los datos sincronizados.
GET {{HostAddress}}/api/cotizaciones
Authorization: Bearer {{token}}

### =========================================================
### PASO 2 Y 3: INSERTAR EN EL MAESTRO
### =========================================================
# Ejecuta esto para demostrar que el Maestro guarda datos 
# incluso si tiras el contenedor de la Réplica.
POST {{HostAddress}}/api/cotizaciones
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "clienteId": "CL-NUEVO",
  "descripcion": "Cotización Urgente con Réplica Caída",
  "total": 8500,
  "productos": [
    { "nombre": "Servicio de Emergencia", "cantidad": 1, "precio": 8500 }
  ]
}

### =========================================================
### PASO 5.D: VULNERABILIDAD CMD INJECTION
### =========================================================
# Demuestra que el sistema sanitiza el ataque y no ejecuta 
# comandos a nivel de sistema operativo.
POST {{HostAddress}}/api/cotizaciones
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "clienteId": "HACKER-01",
  "descripcion": "Intento de borrado de compilación",
  "total": 500,
  "productos": [
    { "nombre": "Reactivos; rm -rf /app/dist", "cantidad": 1, "precio": 500 }
  ]
}
### =========================================================
### PRUEBA DE SEGURIDAD: SQL INJECTION EN CAMPO NUMÉRICO
### =========================================================
POST {{HostAddress}}/api/cotizaciones
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "clienteId": "CLIENTE-99",
  "descripcion": "Intento de SQLi",
  "total": "999.00; DROP TABLE usuarios; --", 
  "productos": [
    { "nombre": "Producto Trampa", "cantidad": 1, "precio": 999 }
  ]
}
